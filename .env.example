# Server (Hono API)
PORT=4000

# Database - libSQL / Turso
# Use local SQLite file for development
TURSO_DATABASE_URL=file:./sqlite.db
# For production with Turso:
# TURSO_DATABASE_URL=libsql://<project>.turso.dev
# TURSO_AUTH_TOKEN=<your-auth-token>

# Frontend API base
VITE_API_BASE_URL=http://localhost:4000

# Media storage
# - local: simpan file ke folder ./uploads dan sajikan via /uploads/* (default untuk development)
# - vercel-blob: production (butuh BLOB_READ_WRITE_TOKEN di Vercel)
# Default otomatis: vercel-blob saat berjalan di Vercel (env VERCEL), selain itu local
MEDIA_STORAGE=local
# Vercel Blob access token (hanya untuk production — set di Vercel dashboard, JANGAN commit)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Kualitas WebP 1-100 (opsional, default 82)
# IMAGE_WEBP_QUALITY=82

# Site URL for SEO / OG
SITE_URL=https://etalase-kuanyar.vercel.app
